<?xml version="1.0" encoding="UTF-8"?>
<GMA3 DataVersion="2.2.1.1">
    <!--
      External plugin (not embedded in the showfile).

      Install folder (recommended):
        gma3_library/datapools/plugins/ResolumeControlPanel/

      Import this XML, then verify on the ComponentLua:
        - Installed = Yes
        - FileName  = ResolumeControlPanel.lua
        - Path      = ResolumeControlPanel   (must match the folder name)

      After editing the .lua on disk:
        ReloadAllPlugins
      You should see: ResolumeControlPanel: v... starting

      NOTE: Paste/import into the Lua editor embeds the code (InStream).
      That path has a size limit and ReloadAllPlugins will NOT pick up
      disk edits. Keep Installed=Yes / external file.
    -->
    <UserPlugin Name="ResolumeControlPanel" Version="1.2.6.0" Author="Sedat Çapkın &amp; Simon Kotting" Path="ResolumeControlPanel">
        <ComponentLua Name="ResolumeControlPanel" FileName="ResolumeControlPanel.lua"/>
    </UserPlugin>
</GMA3>
