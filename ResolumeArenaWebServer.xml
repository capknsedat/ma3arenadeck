<?xml version="1.0" encoding="UTF-8"?>
<GMA3 DataVersion="2.2.1.1">
    <!--
      External plugin (not embedded in the showfile).

      Install folder (recommended):
        gma3_library/datapools/plugins/ResolumeArenaWebServer/

      Import this XML, then verify on the ComponentLua:
        - Installed = Yes
        - FileName  = ResolumeArenaWebServer.lua
        - Path      = ResolumeArenaWebServer   (must match the folder name)

      After editing the .lua on disk:
        ReloadAllPlugins
      You should see: ResArena: v... starting

      NOTE: Paste/import into the Lua editor embeds the code (InStream).
      That path has a size limit and ReloadAllPlugins will NOT pick up
      disk edits. Keep Installed=Yes / external file.
    -->
    <UserPlugin Name="Resolume Arena Web Server" Version="0.2.0.0" Author="Sedat (based on MA3ArenaDeck by Simon Kotting)" Path="ResolumeArenaWebServer">
        <ComponentLua Name="ResolumeArenaWebServer" FileName="ResolumeArenaWebServer.lua"/>
    </UserPlugin>
</GMA3>
